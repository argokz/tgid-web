# API Configuration
EXTERNAL_API_URL=http://localhost:8000
NUXT_PUBLIC_MAP_API_BASE_URL=http://localhost:8000
NUXT_PUBLIC_MAPTILER_KEY=your_maptiler_public_key

# GeoServer Public Configuration
NUXT_PUBLIC_GEOSERVER_URL=https://example.com/geoserver
NUXT_PUBLIC_GEOSERVER_WORKSPACE=ExampleWorkspace
NUXT_PUBLIC_GEOSERVER_GROUP_NAME=ExampleWorkspace
NUXT_PUBLIC_GEOSERVER_WORKSPACES=[{"id":"example","name":"Example","url":"https://example.com/geoserver","workspace":"ExampleWorkspace","groupName":"ExampleWorkspace","enabled":true,"order":1}]

# Server-side GeoServer Configuration
GEOSERVER_CAPABILITIES_URL=https://example.com/geoserver/example/gwc/service/wmts?REQUEST=GetCapabilities
GEOSERVER_MVT_TEMPLATE_URL=https://example.com/geoserver/example/gwc/service/wmts?SERVICE=WMTS&VERSION=1.0.0&REQUEST=GetTile&LAYER={layerName}&STYLE=&TILEMATRIXSET=EPSG:900913&TILEMATRIX=EPSG:900913:{z}&TILEROW={y}&TILECOL={x}&FORMAT=application/vnd.mapbox-vector-tile
GEOSERVER_DESCRIBE_FEATURE_URL=https://example.com/geoserver/example/ows
GEOSERVER_LAYER_NAMESPACE=example
