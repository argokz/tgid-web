# API
EXTERNAL_API_URL=http://localhost:8000
NUXT_PUBLIC_MAP_API_BASE_URL=http://localhost:8000
NUXT_PUBLIC_MAPTILER_KEY=your_maptiler_public_key
NUXT_PUBLIC_CESIUM_ION_TOKEN=
# Включать только после проверки схемы БД, резервного копирования и прав доступа.
NUXT_PUBLIC_TOPOLOGY_EDITING_ENABLED=false

# Запись в журналы/атрибуты. Включать только вместе с API MUTATIONS_ENABLED и auth.
NUXT_PUBLIC_MUTATIONS_ENABLED=false

# false для локальной/CI-сборки или если gzip/brotli выполняет nginx/CDN.
NITRO_COMPRESS_PUBLIC_ASSETS=true

# Корень GeoServer (fallback, если у workspace в каталоге не указан свой url)
NUXT_PUBLIC_GEOSERVER_URL=https://example.com/geoserver

# Каталог схем и слоёв (JSON-массив). У каждого слоя: source, label, mvt, wms (хотя бы один true).
# defaultRenderFormat — если оба true: начальный режим «mvt» или «wms».
GEOSERVER_LAYER_CATALOG=[{"id":"example","name":"Пример схемы","url":"https://example.com/geoserver","workspace":"ExampleWS","groupName":"ExampleWS","enabled":true,"order":1,"layers":[{"source":"my_layer","label":"Мой слой","mvt":true,"wms":false}]}]

GEOSERVER_CAPABILITIES_URL=https://example.com/geoserver/gwc/service/wmts?REQUEST=GetCapabilities
GEOSERVER_MVT_TEMPLATE_URL=https://example.com/geoserver/ows?SERVICE=WMS&VERSION=1.1.1&REQUEST=GetMap&LAYERS={layerName}&BBOX={bbox-epsg-3857}&WIDTH=256&HEIGHT=256&SRS=EPSG:3857&FORMAT=application/vnd.mapbox-vector-tile

GEOSERVER_REST_URL=
GEOSERVER_REST_USER=
GEOSERVER_REST_PASSWORD=
# В production передавайте REST_USER/REST_PASSWORD окружению Node/PM2 при
# запуске `.output/server/index.mjs`; секреты намеренно не встраиваются в build.

# GEOSERVER_MVT_PROBE_TILES=true

# Автообнаружение слоёв GeoServer: список workspace через запятую или "*" — все опубликованные
GEOSERVER_DISCOVER_WORKSPACES=AlmatyGIS,Almaty2
# Вспомогательные слои (отдельная свёрнутая группа, выключены по умолчанию)
# GEOSERVER_SERVICE_LAYERS=city_center,file,find_node,fragments
