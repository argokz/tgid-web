{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && node ./scripts/apply-pinia-ssr-patch.mjs && patch-package",
    "format": "prettier . --write",
    "format:check": "prettier . --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf:budget": "node ./scripts/perf-budget.mjs",
    "check": "npm run lint && npm run typecheck && npm run test",
    "ci": "npm run check && npm run build"
  },
  "dependencies": {
    "@birkskyum/maplibre-gl-draw": "npm:@jsr/birkskyum__maplibre-gl-draw@^2.1.2",
    "@fontsource-variable/roboto": "^5.2.10",
    "@mapbox/mapbox-gl-draw": "^1.5.0",
    "@maplibre/maplibre-gl-geocoder": "^1.8.0",
    "@mdi/js": "^7.4.47",
    "@pinia/nuxt": "^0.10.1",
    "@types/jsdom": "^21.1.7",
    "fast-xml-parser": "^4.0.0",
    "jsdom": "^26.1.0",
    "nuxt": "^3.19.3",
    "pinia": "^3.0.1",
    "three": "^0.184.0",
    "threebox-plugin": "^2.2.7",
    "vue": "latest",
    "vue-router": "latest"
  },
  "overrides": {
    "vue": "latest",
    "@rollup/plugin-terser": "^1.0.0",
    "serialize-javascript": "^7.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/mapbox-gl": "^3.4.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.22.0",
    "eslint-plugin-vue": "^9.33.0",
    "happy-dom": "^20.8.4",
    "patch-package": "^8.0.1",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.26.1",
    "vite-plugin-vuetify": "^2.1.0",
    "vitest": "^3.0.9",
    "vuetify": "^3.7.16"
  }
}
